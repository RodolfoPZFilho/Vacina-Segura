# Modelo do .env (NAO coloque senhas reais aqui). Gere o .env de verdade com:
#   Windows: powershell -ExecutionPolicy Bypass -File gerar-segredos.ps1
#   Linux/macOS: ./gerar-segredos.sh
MQTT_SIMULADOR_SENHA=
MQTT_GATEWAY_SENHA=
RABBIT_ADMIN_USUARIO=vs-admin
RABBIT_ADMIN_SENHA=
RABBIT_GATEWAY_SENHA=
RABBIT_GRAVADOR_SENHA=
RABBIT_INFERENCIA_SENHA=
RABBIT_LAB_SENHA=
RABBIT_API_SENHA=
INFLUX_SENHA=
INFLUX_TOKEN=
POSTGRES_PASSWORD=
JWT_SEGREDO=
ADMIN_SENHA=
OPERADOR_SENHA=
VISUALIZADOR_SENHA=
# Modelo do LLM local. Em maquina com 16 GB de RAM pode usar llama3.2:3b
OLLAMA_MODELO=llama3.2:1b
# Segundos reais por leitura (cada leitura = 5 minutos simulados)
TICK_SEGUNDOS=5
PORTA_WEB=8080
