# Copie para .env (ou rode infra\configurar-influxdb.ps1, que gera o .env automaticamente)
INFLUX_URL=http://localhost:8086
INFLUX_TOKEN=coloque-o-token-aqui
INFLUX_ORG=vacinasegura
INFLUX_BUCKET=leituras

MQTT_HOST=localhost
MQTT_PORT=1884
MQTT_TOPICO=vacinasegura/ubs/+/geladeira/+

# Faixa segura de conservação das vacinas (graus Celsius)
TEMP_MIN=2
TEMP_MAX=8
